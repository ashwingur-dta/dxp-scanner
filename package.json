{
  "name": "dxp-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assess Australian government websites against the Digital Experience Policy",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "scan": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx packages/**/test/*.test.ts",
    "postinstall": "playwright install chromium",
    "build": "node scripts/build.mjs",
    "build:web": "npm run build --workspace @dxp/web",
    "rubric": "tsx packages/cli/src/index.ts --rubric",
    "test:ui": "node test/ui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@axe-core/playwright": "^4.10.2",
    "@sparticuz/chromium": "^153.0.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.56.0",
    "playwright-core": "^1.64.0",
    "yaml": "^2.8.1"
  }
}
