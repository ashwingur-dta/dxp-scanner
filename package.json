{
  "name": "dxp-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assess Australian government websites against the Digital Experience Policy",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "scan": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx packages/**/test/*.test.ts",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "axe-core": "^4.10.3",
    "playwright": "^1.56.0",
    "yaml": "^2.8.1"
  }
}
